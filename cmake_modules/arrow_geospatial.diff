+constexpr char kExtensionName[] = "ARROW:extension:name";
+constexpr char kExtensionMetadata[] = "ARROW:extension:metadata";
+constexpr char kWkbExtension[] = "geoarrow.wkb";
+
+::arrow::Result<std::shared_ptr<const LogicalType>> GeospatialLogicalType(
+    const Field& field) {
+  const auto& metadata = field.metadata();
+  int index = metadata ? metadata->FindKey(kExtensionName) : -1;
+  if (index < 0 || metadata->value(index) != kWkbExtension) {
+    return LogicalType::None();
+  }
+  if (field.type()->id() != ArrowTypeId::BINARY) {
+    return Status::Invalid("geoarrow.wkb requires Binary storage");
+  }
+
+  std::string crs = "OGC:CRS84";
+  std::string edges = "planar";
+  if (metadata->Contains(kExtensionMetadata)) {
+    ASSIGN_OR_RAISE(auto json, metadata->Get(kExtensionMetadata));
+    ::arrow::rapidjson::Document doc;
+    doc.Parse(json.data(), json.size());
+    if (doc.HasParseError() || !doc.IsObject()) {
+      return Status::Invalid("Invalid geoarrow.wkb metadata");
+    }
+    if (doc.HasMember("crs")) {
+      if (!doc["crs"].IsString() || doc["crs"].GetStringLength() == 0) {
+        return Status::Invalid("geoarrow.wkb requires a nonempty CRS");
+      }
+      crs.assign(doc["crs"].GetString(), doc["crs"].GetStringLength());
+    }
+    if (doc.HasMember("edges")) {
+      if (!doc["edges"].IsString()) {
+        return Status::Invalid("geoarrow.wkb edges must be a string");
+      }
+      edges.assign(doc["edges"].GetString(), doc["edges"].GetStringLength());
+    }
+  }
+  if (edges == "planar") return LogicalType::Geometry(std::move(crs));
+
+  using Algorithm = LogicalType::EdgeInterpolationAlgorithm;
+  static constexpr std::pair<std::string_view, Algorithm> algorithms[] = {
+      {"spherical", Algorithm::SPHERICAL}, {"vincenty", Algorithm::VINCENTY},
+      {"thomas", Algorithm::THOMAS}, {"andoyer", Algorithm::ANDOYER},
+      {"karney", Algorithm::KARNEY}};
+  for (const auto& [name, algorithm] : algorithms) {
+    if (::arrow::internal::AsciiEqualsCaseInsensitive(edges, name)) {
+      return LogicalType::Geography(std::move(crs), algorithm);
+    }
+  }
+  return Status::Invalid("Invalid geoarrow.wkb edge interpolation algorithm: ", edges);
+}
+
+std::shared_ptr<const KeyValueMetadata> GeospatialMetadata(const LogicalType& type) {
+  if (!type.is_geometry() && !type.is_geography()) return nullptr;
+  namespace rj = ::arrow::rapidjson;
+  std::string_view crs;
+  rj::StringBuffer buffer;
+  rj::Writer<rj::StringBuffer> writer(buffer);
+  writer.StartObject();
+  if (type.is_geography()) {
+    const auto& geography = checked_cast<const GeographyLogicalType&>(type);
+    crs = geography.crs();
+    writer.Key("edges");
+    auto edges = geography.algorithm_name();
+    writer.String(edges.data(), static_cast<rj::SizeType>(edges.size()));
+  } else {
+    crs = checked_cast<const GeometryLogicalType&>(type).crs();
+  }
+  if (crs.empty()) crs = "OGC:CRS84";
+  writer.Key("crs");
+  writer.String(crs.data(), static_cast<rj::SizeType>(crs.size()));
+  writer.EndObject();
+  return ::arrow::key_value_metadata({kExtensionName, kExtensionMetadata},
+                                     {kWkbExtension, buffer.GetString()});
+}
