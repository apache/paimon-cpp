+    #[test]
+    #[cfg_attr(miri, ignore)]
+    fn test_paimon_read_defaults_survive_handle_lifetimes() {
+        unsafe {
+            let first = vx_paimon_read_session_new();
+            let second = vx_paimon_read_session_new();
+            assert_ne!(first, second);
+            let expected = vx_session::as_ref(first)
+                .arrays()
+                .registry()
+                .ids()
+                .collect::<BTreeSet<_>>();
+            vx_session_free(first);
+            let actual = vx_session::as_ref(second)
+                .arrays()
+                .registry()
+                .ids()
+                .collect::<BTreeSet<_>>();
+            assert_eq!(actual, expected);
+            assert!(!actual.is_empty());
+            drop(vx_session::as_ref(second).handle());
+            vx_session_free(second);
+        }
+    }
