+// This session is private to the Paimon callback reader. Public/configurable
+// sessions must remain fresh: VortexSession::clone shares mutable SessionVars.
+// Single-file callback opens keep file metadata, caches and execution contexts
+// outside this default session. Initialize the only lazy read-path registry
+// before publishing it, and never configure/register against these handles.
+static PAIMON_READ_SESSION: LazyLock<VortexSession> = LazyLock::new(|| {
+    let session = VortexSession::default().with_handle(RUNTIME.handle());
+    drop(session.arrow());
+    session
+});
+
+/// Create an owned handle to Paimon's shared default callback-reader session.
+///
+/// This private integration entry point does not change the isolation of
+/// [`vx_session_new`] or [`vx_session_new_with`]. Free the owned handle with
+/// [`vx_session_free`]; other reader handles remain valid.
+///
+/// # Safety
+///
+/// The handle is only for Paimon's fixed-runtime, single-file callback read and
+/// Arrow export paths. The caller must not configure it, register plugins, change
+/// session variables/allocators/runtime, or pass it to a writer or multi-file
+/// source. Those operations require a fresh [`vx_session_new`] session.
+#[unsafe(no_mangle)]
+pub unsafe extern "C-unwind" fn vx_paimon_read_session_new() -> *mut vx_session {
+    vx_session::new(PAIMON_READ_SESSION.clone())
+}

