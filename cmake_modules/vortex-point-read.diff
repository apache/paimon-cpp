+    #[test]
+    #[cfg_attr(miri, ignore)]
+    fn test_configured_sessions_are_isolated_from_paimon_read_defaults() {
+        unsafe {
+            let custom_id = Id::new("paimon.session.isolation-test");
+            let custom = vx_session_new_with(|session| {
+                let registry = session.arrays().registry().clone();
+                let plugin = registry.items().next();
+                if let Some(plugin) = plugin {
+                    registry.register(custom_id, plugin);
+                }
+                session.allow_unknown()
+            });
+            let reader = vx_paimon_read_session_new();
+            let fresh = vx_session_new();
+            assert!(vx_session::as_ref(custom).allows_unknown());
+            assert!(
+                vx_session::as_ref(custom)
+                    .arrays()
+                    .registry()
+                    .find(&custom_id)
+                    .is_some()
+            );
+            for handle in [reader, fresh] {
+                let session = vx_session::as_ref(handle);
+                assert!(!session.allows_unknown());
+                assert!(session.arrays().registry().find(&custom_id).is_none());
+            }
+            vx_session_free(custom);
+            vx_session_free(reader);
+            vx_session_free(fresh);
+        }
+    }
