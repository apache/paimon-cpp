+    #[test]
+    fn repeated_nullable_filters_share_lazy_expression_cache() -> VortexResult<()> {
+        block_on(|handle| async move {
+            let session = session_with_handle(handle);
+            let strategy = DictStrategy::new(
+                FlatLayoutStrategy::default(),
+                FlatLayoutStrategy::default(),
+                FlatLayoutStrategy::default(),
+                DictLayoutOptions::default(),
+            );
+            let array = VarBinArray::from_iter(
+                [
+                    Some("abc"),
+                    Some("def"),
+                    None,
+                    Some("abc"),
+                    Some("def"),
+                    None,
+                    Some("abc"),
+                    Some("def"),
+                    None,
+                ],
+                DType::Utf8(Nullability::Nullable),
+            )
+            .into_array();
+            let segments = Arc::new(TestSegments::default());
+            let (ptr, eof) = SequenceId::root().split();
+            let layout = strategy
+                .write_stream(
+                    ArrayContext::empty(),
+                    Arc::<TestSegments>::clone(&segments),
+                    SequentialStreamAdapter::new(
+                        DType::Utf8(Nullability::Nullable),
+                        array.to_array_stream().sequenced(ptr),
+                    )
+                    .sendable(),
+                    eof,
+                    &session,
+                )
+                .await?;
+            assert!(layout.encoding_id() == LayoutId::new("vortex.dict"));
+            let reader = layout.new_reader("".into(), segments, &session, &Default::default())?;
+            let dict_reader = reader
+                .as_any()
+                .downcast_ref::<DictReader>()
+                .ok_or_else(|| vortex_err!("dict fixture did not create a DictReader"))?;
+            assert!(dict_reader.values_evals.get().is_none());
+
+            let filter = eq(
+                root(),
+                lit(vortex_array::scalar::Scalar::utf8(
+                    "abc",
+                    Nullability::Nullable,
+                )),
+            );
+            let first_mask = reader
+                .filter_evaluation(&(0..9), &filter, MaskFuture::new_true(9))?
+                .await?;
+            let expected = [true, false, false, true, false, false, true, false, false];
+            assert_arrays_eq!(first_mask.into_array(), BoolArray::from_iter(expected));
+            let cache = dict_reader
+                .values_evals
+                .get()
+                .ok_or_else(|| vortex_err!("filter did not initialize the expression cache"))?;
+            assert_eq!(cache.len(), 1);
+            let first_future = cache
+                .get(&filter)
+                .ok_or_else(|| vortex_err!("first expression future is missing"))?
+                .value()
+                .clone();
+
+            let second_mask = reader
+                .filter_evaluation(&(0..9), &filter, MaskFuture::new_true(9))?
+                .await?;
+            assert_arrays_eq!(second_mask.into_array(), BoolArray::from_iter(expected));
+            assert_eq!(cache.len(), 1);
+            let second_future = cache
+                .get(&filter)
+                .ok_or_else(|| vortex_err!("repeated expression future is missing"))?
+                .value()
+                .clone();
+            assert!(first_future.ptr_eq(&second_future));
+            Ok(())
         })
     }

