+    }
+    if (page.offset < previous_end || page.page_ordinal <= previous_ordinal) {
+      throw ParquetException("Data page read plan entries must be ordered");
+    }
+    previous_end = page_end;
+    previous_ordinal = page.page_ordinal;
+  }
