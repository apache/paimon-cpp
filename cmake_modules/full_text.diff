+/// Write the same archive as the on-disk writer, including Tantivy's segment footers.
+fn write_ram_archive<W: SeekWrite>(
+    output: &mut W,
+    metadata: FullTextIndexMetadata,
+    index: Index,
+    directory: RamDirectory,
+) -> Result<()> {
+    let mut paths: Vec<_> = index.directory().list_managed_files().into_iter().collect();
+    paths.push(PathBuf::from(".managed.json"));
+    paths.sort();
+    let mut files = Vec::with_capacity(paths.len());
+    let mut contents = Vec::with_capacity(paths.len());
+    let mut offset = 0u64;
+    for path in paths {
+        let bytes = directory
+            .open_read(&path)
+            .map_err(tantivy::TantivyError::from)?
+            .read_bytes()?;
+        let length = bytes.len() as u64;
+        files.push(ArchiveFileEntry {
+            name: path.to_string_lossy().into_owned(),
+            offset,
+            length,
+        });
+        offset = offset.checked_add(length).ok_or_else(|| {
+            FtIndexError::InvalidStorage("full-text archive size overflow".to_string())
+        })?;
+        contents.push(bytes);
+    }
+    write_envelope_header(output, &IndexHeader { metadata, files })?;
+    for bytes in contents {
+        output.write_all(bytes.as_slice())?;
+    }
+    output.flush()?;
+    Ok(())
 }

