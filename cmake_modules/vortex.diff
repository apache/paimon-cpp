+// Assemble only referenced slices in output order. In particular, a take of arbitrary encoded
+// children may execute the entire values array before selecting indices; a ListView rebuild may
+// do the same. Keeping the ranges as chunks lets recursive Arrow export materialize each slice.
+fn compact_list_view_elements(
+    array: &ListViewArray,
+    ctx: &mut ExecutionCtx,
+) -> VortexResult<ListArray> {
+    let validity = array.validity()?;
+    let valid = validity.execute_mask(array.len(), ctx)?;
+    let offsets = array
+        .offsets()
+        .cast(DType::Primitive(PType::U64, Nullability::NonNullable))?
+        .execute::<PrimitiveArray>(ctx)?
+        .to_buffer::<u64>();
+    let sizes = array
+        .sizes()
+        .cast(DType::Primitive(PType::U64, Nullability::NonNullable))?
+        .execute::<PrimitiveArray>(ctx)?
+        .to_buffer::<u64>();
+
+    let mut chunks = Vec::with_capacity(array.len());
+    let mut list_offsets = BufferMut::<u64>::with_capacity(array.len() + 1);
+    let mut n_elements = 0u64;
+    list_offsets.push(n_elements);
+    for index in 0..array.len() {
+        if valid.value(index) && sizes[index] != 0 {
+            let start = usize::try_from(offsets[index])
+                .map_err(|error| vortex_err!("List offset out of range: {error}"))?;
+            let size = usize::try_from(sizes[index])
+                .map_err(|error| vortex_err!("List size out of range: {error}"))?;
+            let end = start
+                .checked_add(size)
+                .ok_or_else(|| vortex_err!("List element range overflow"))?;
+            n_elements = n_elements
+                .checked_add(sizes[index])
+                .ok_or_else(|| vortex_err!("List output element count overflow"))?;
+            chunks.push(array.elements().slice(start..end)?);
+        }
+        list_offsets.push(n_elements);
+    }
+
+    let elements = if chunks.is_empty() {
+        Canonical::empty(array.elements().dtype()).into_array()
+    } else {
+        ChunkedArray::try_new(chunks, array.elements().dtype().clone())?.into_array()
+    };
+    ListArray::try_new(
+        elements,
+        PrimitiveArray::new(list_offsets.freeze(), Validity::NonNullable).into_array(),
+        validity,
+    )
+}
