+#[cfg(test)]
+mod tests {
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    use vortex_buffer::buffer;
+
+    use super::*;
+    use crate::arrays::ScalarFnArray;
+    use crate::assert_arrays_eq;
+    use crate::scalar_fn::TypedScalarFnInstance;
+    use crate::scalar_fn::fns::binary::Binary;
+    use crate::scalar_fn::fns::operators::Operator;
+
+    static REENTRANT_KERNEL_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+    fn reentrant_kernel(
+        _child: &ArrayRef,
+        _parent: &ArrayRef,
+        _child_idx: usize,
+        ctx: &mut ExecutionCtx,
+    ) -> VortexResult<Option<ArrayRef>> {
+        // Reacquiring this exact SessionVar for writing must not inherit the registry's read lock.
+        // Unlike relying on two TypeIds sharing a shard, this fails deterministically if it does.
+        drop(ctx.session().get_mut::<ArrayKernels>());
+        REENTRANT_KERNEL_CALLS.fetch_add(1, Ordering::SeqCst);
+        Ok(Some(buffer![11_i32, 22].into_array()))
+    }
+
+    #[test]
+    fn execute_parent_kernel_can_reenter_session() -> VortexResult<()> {
+        let lhs = buffer![1_i32, 2].into_array();
+        let rhs = buffer![10_i32, 20].into_array();
+        let scalar_fn = TypedScalarFnInstance::new(Binary, Operator::Add).erased();
+        let parent = ScalarFnArray::try_new(scalar_fn, vec![lhs.clone(), rhs])?.into_array();
+        let session = VortexSession::empty().with::<ArrayKernels>();
+        session.get::<ArrayKernels>().register_execute_parent(
+            parent.encoding_id(),
+            lhs.encoding_id(),
+            &[reentrant_kernel],
+        );
+        let mut ctx = ExecutionCtx::new(session);
+        let expected = buffer![11_i32, 22].into_array();
+
+        // Cover both the single-step executor and the matcher-driven execution loop.
+        let single_step = parent.clone().execute::<ArrayRef>(&mut ctx)?;
+        assert_arrays_eq!(single_step, expected);
+        let canonical = parent.execute::<Canonical>(&mut ctx)?.into_array();
+        assert_arrays_eq!(canonical, expected);
+        assert_eq!(REENTRANT_KERNEL_CALLS.load(Ordering::SeqCst), 2);
+        Ok(())
+    }
+}
